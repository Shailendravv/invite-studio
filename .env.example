# ---------- Core ----------
# Owner login password (required). It is hashed in memory with scrypt at startup;
# alternatively set ADMIN_PASSWORD_HASH (output of `npm run hash-password -- "your password"`) and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies and download links (required).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SIGNING_SECRET=

# Hours before a download link expires
LINK_TTL_HOURS=72

# Where the SQLite database and videos live (relative paths resolve from the repo root)
DATABASE_PATH=./data/app.db
STORAGE_ROOT=./storage

# Web server port (ngrok tunnels to this)
PORT=3000

# ---------- LLM ----------
# anthropic | openai | gemini | ollama | mock
LLM_PROVIDER=anthropic
# Optional override; defaults per provider:
#   anthropic: claude-haiku-4-5-20251001   openai: gpt-4o-mini
#   gemini: gemini-2.5-flash              ollama: llama3.1
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For OpenAI-compatible servers (LM Studio, vLLM, ...). Leave empty for api.openai.com
OPENAI_BASE_URL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Visual QA of rendered stills (only runs when the provider supports images)
QA_ENABLED=true

# ---------- Tunnel ----------
NGROK_AUTHTOKEN=
# Your static domain, e.g. invite-studio.ngrok-free.app
NGROK_DOMAIN=
# Used to build download links. Defaults to https://$NGROK_DOMAIN, else http://localhost:$PORT
PUBLIC_BASE_URL=

# ---------- Notifications (optional) ----------
# ntfy | telegram | (empty = off)
NOTIFY_PROVIDER=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Worker ----------
WORKER_POLL_MS=2000
PARSE_CONCURRENCY=3
# Remotion render concurrency (frames rendered in parallel). Empty = Remotion default
RENDER_CONCURRENCY=
